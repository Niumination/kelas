# ─────────────────────────────────────────────────────────────
# Salin ke .env.local lalu isi. Tanpa variabel ini, aplikasi
# tetap berjalan dalam MODE DEMO (konten bisa dibaca, auth & 
# pembayaran dinonaktifkan).
# ─────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server key (opsional, untuk admin query). JANGAN expose ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat publik situs (dipakai OAuth redirect & webhook)
NEXT_PUBLIC_SITE_URL=https://kelas.niumination.web.id

# ── Midtrans (Fase 2) ────────────────────────────────────────
# Sandbox: https://dashboard.sandbox.midtrans.com
# Produksi: https://dashboard.midtrans.com
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx

# Magic link email diatur melalui Supabase Auth → SMTP Settings.
# Kredensial SMTP (mis. API key Resend) hanya disimpan di dashboard Supabase,
# bukan di .env.local/Vercel; aplikasi Next.js tidak mengirim email langsung.
